{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about-pragati-exim", "destination": "/about-us", "permanent": true },
    { "source": "/global-export", "destination": "/export-markets", "permanent": true },
    { "source": "/blog", "destination": "/resources", "permanent": true },
    { "source": "/blog/:slug", "destination": "/resources/:slug", "permanent": true },
    { "source": "/contact", "destination": "/contact-us", "permanent": true },
    { "source": "/request-quote", "destination": "/contact-us", "permanent": true },
    { "source": "/site-directory", "destination": "/sitemap", "permanent": true },
    { "source": "/terms", "destination": "/terms-and-conditions", "permanent": true }
  ],
  "rewrites": [
    { "source": "/products", "destination": "/index.html" },
    { "source": "/products/:slug", "destination": "/index.html" },
    { "source": "/extracts/:slug", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
